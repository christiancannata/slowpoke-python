#!/bin/sh
# Publishes this directory to the package's own repository, which is what Packagist reads.
#
#   ./bin/publish 0.1.3            sync, commit, tag v0.1.3, push
#   ./bin/publish 0.1.3 --dry-run  show what would change and stop
#
# The two repositories have separate histories on purpose: this one carries the whole of
# Slowpoke, that one carries only the package, so the published history is not a stream of
# commits about an agent written in Go. The sync is a copy plus one commit, never a force push.
set -eu

REMOTE="${SLOWPOKE_PYTHON_REMOTE:-git@github.com:christiancannata/slowpoke-python.git}"
VERSION="${1:-}"
DRY="${2:-}"
[ -n "$VERSION" ] || { echo "usage: ./bin/publish <version> [--dry-run]" >&2; exit 2; }
cd "$(dirname "$0")/.."

grep -q "^## $VERSION " CHANGELOG.md || { echo "CHANGELOG.md has no entry for $VERSION" >&2; exit 1; }
# What CI checks, checked here first: a line two characters too long stopped a release once,
# after the tag was already pushed.
docker run --rm -v "$PWD":/w -w /w python:3.12-alpine \
	sh -c 'pip install -q ruff && ruff check src tests' || { echo "ruff is not happy" >&2; exit 1; }
./bin/test 3.13 >/dev/null || { echo "the suite does not pass on Python 3.13" >&2; exit 1; }
./bin/test 3.9 >/dev/null || { echo "the suite does not pass on Python 3.9" >&2; exit 1; }

work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT INT TERM
git clone -q "$REMOTE" "$work/repo"
rsync -a --delete --exclude='.git' --exclude='__pycache__' --exclude='.pytest_cache' \
	--exclude='*.egg-info' --exclude='dist' ./ "$work/repo/"

cd "$work/repo"
if git diff --quiet && [ -z "$(git status --porcelain)" ]; then
	echo "The published package already matches this directory: nothing to do."
	exit 0
fi
git add -A
git -c color.ui=always diff --cached --stat | tail -20
if [ "$DRY" = "--dry-run" ]; then
	echo "\nNothing was pushed."
	exit 0
fi

# The first line of the version's changelog entry becomes the subject; the entry is the body.
summary="$(awk "/^## $VERSION /{flag=1; next} /^## /{flag=0} flag" ../repo/CHANGELOG.md | sed '/^$/d' | head -20)"
printf '%s\n\n%s\n' "$VERSION" "$summary" | git commit -q -F -
git tag -a "v$VERSION" -m "$VERSION"
git push origin HEAD --follow-tags
echo "Published $VERSION. Packagist follows within a minute; the release workflow builds the archive."
